<!-- Productions Header -->
<section class="bg-[#1C3A47] text-[#F5EED6] py-16">
  <div class="container mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Productions</h1>
    <p class="text-xl opacity-90">Quality theater for the whole family</p>
  </div>
</section>

<!-- Upcoming Shows -->
<%= if @upcoming != [] do %>
  <section class="py-12 bg-[#F5EED6]">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-[#1C3A47] mb-8 text-center">Coming Soon</h2>
      <div class="grid gap-8 max-w-2xl mx-auto">
        <div :for={production <- @upcoming} class="bg-white rounded-lg shadow-lg overflow-hidden">
          <div class="bg-[#C23B23] text-white p-4 text-center">
            <span class="text-sm uppercase tracking-wide font-semibold">Next Production</span>
          </div>
          <%= if production.main_image_url do %>
            <img
              src={"/images/w/800#{production.main_image_url}"}
              alt={production.title}
              class="w-full h-64 object-cover"
            />
          <% end %>
          <div class="p-8 text-center">
            <h3 class="text-3xl font-bold text-[#1C3A47] mb-2">
              &ldquo;{production.title}&rdquo;
            </h3>
            <%= if date_range = Spotlight.Productions.format_date_range(production) do %>
              <p class="text-[#D4A574] font-semibold text-xl mb-4">{date_range}</p>
            <% end %>
            <%= if production.description do %>
              <div class="text-gray-700 mb-6 rich-text mx-auto">{raw(production.description)}</div>
            <% end %>
            <div class="bg-[#F5EED6] p-4 rounded-lg mb-6">
              <%= if production.location_name do %>
                <p class="text-sm text-gray-600 mb-1">
                  <strong>Location:</strong> {production.location_name}
                </p>
              <% end %>
              <%= if production.location_query do %>
                <p class="text-sm text-gray-600 mb-1">
                  <strong>Address:</strong> {production.location_query}
                </p>
              <% end %>
              <%= if production.price do %>
                <p class="text-sm text-gray-600">
                  <strong>Admission:</strong> {production.price}
                </p>
              <% end %>
            </div>
            <% perf_tickets = Enum.filter(production.performances, & &1.ticket_url) %>
            <%= if perf_tickets != [] do %>
              <div class="flex flex-col gap-2 items-center">
                <%= for perf <- perf_tickets do %>
                  <a
                    href={perf.ticket_url}
                    target="_blank"
                    rel="noopener"
                    class="inline-block bg-[#C23B23] hover:bg-[#C23B23]/80 text-white px-6 py-3 rounded-lg font-semibold transition w-full max-w-xs"
                  >
                    {Calendar.strftime(perf.starts_at, "%a %b %-d at %-I:%M %p")}
                  </a>
                <% end %>
              </div>
            <% else %>
              <%= if production.ticket_url do %>
                <a
                  href={production.ticket_url}
                  target="_blank"
                  rel="noopener"
                  class="inline-block bg-[#C23B23] hover:bg-[#C23B23]/80 text-white px-6 py-3 rounded-lg font-semibold transition"
                >
                  Get Tickets
                </a>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- Past Productions -->
<%= if @past != [] do %>
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-[#1C3A47] mb-8 text-center">Past Productions</h2>
      <div class="flex flex-wrap justify-center gap-6 max-w-5xl mx-auto">
        <div :for={production <- @past} class="bg-[#F5EED6] rounded-lg overflow-hidden shadow-md max-w-sm flex-none">
          <%= if production.main_image_url do %>
            <img
              src={"/images/w/400#{production.main_image_url}"}
              alt={production.title}
              class="w-full h-48 object-cover"
            />
          <% end %>
          <div class="p-6">
            <h3 class="text-xl font-bold text-[#1C3A47] mb-2">
              &ldquo;{production.title}&rdquo;
            </h3>
            <%= if date_range = Spotlight.Productions.format_date_range(production) do %>
              <p class="text-[#D4A574] font-semibold mb-3">{date_range}</p>
            <% end %>
            <%= if production.description do %>
              <div class="text-gray-600 text-sm rich-text">{raw(production.description)}</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- Get Involved -->
<section class="py-12 bg-[#F5EED6]">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-[#1C3A47] mb-6">Want to Perform?</h2>
      <p class="text-lg text-gray-700 mb-6">
        We're always looking for performers of all ages and experience levels!
        Whether you want to be on stage or help behind the scenes, there's a place for you.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contact"
          class="inline-block bg-[#C23B23] hover:bg-[#C23B23]/80 text-white px-6 py-3 rounded-lg font-semibold transition"
        >
          Contact Us to Audition
        </a>
        <a
          href="https://facebook.com/SpotlightHSCTheater/"
          target="_blank"
          rel="noopener"
          class="inline-block bg-[#1C3A47] hover:bg-[#1C3A47]/80 text-white px-6 py-3 rounded-lg font-semibold transition"
        >
          Follow on Facebook
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Photo Gallery (from all productions) -->
<% all_photos = Enum.flat_map(@upcoming ++ @past, & &1.photos) %>
<%= if all_photos != [] do %>
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-[#1C3A47] mb-8 text-center">Production Photos</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        <img
          :for={photo <- all_photos}
          src={"/images/w/400#{photo.url}"}
          alt={photo.caption || "Production photo"}
          class="rounded-lg shadow-md object-cover w-full h-48"
        />
      </div>
    </div>
  </section>
<% end %>
